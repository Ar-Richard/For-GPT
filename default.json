	//家具描述
	"SDS_doll1.name": "瑞恩公仔",
	"SDS_doll1.description": "嘛，你在看什么？可爱？所以你要对这么可爱的我们做什么呢，变▪态~！",
	"SDS_doll2.name": "莱恩公仔",
	"SDS_doll2.description": "诶呀，直愣愣的盯那么久可是要收费的哦。",
	"SDS_doll3.name": "卢卡斯公仔",
	"SDS_doll3.description": "（叼空气玫瑰）（试图突出帅气）（变的更可爱了！）（努力地wink）你今天感觉如何？",
	"SDS_doll4.name": "洛离公仔",
	"SDS_doll4.description": "叽叽咕咕...咕叽咕叽......Zzz......",
	"SDS_doll5.name": "莫尔公仔",
	"SDS_doll5.description": "只放了我一个？这种话不说也可以。（沉默）我没小气到那种地步，反正只是玩偶。",
	"SDS_doll6.name": "佩莱特公仔",
	"SDS_doll6.description": "出门要带上我吗？我可以保护你...（公仔式沉默）陪着你，替你挡刀之类。",
	"SDS_doll7.name": "霍夫塞普公仔",
	"SDS_doll7.description": "啊啊啊......我、我是不是在做梦...？那、那，我会陪着你的！一直！",
	"SDS_doll8.name": "乌列公仔",
	"SDS_doll8.description": "嗯......我在这里，想对我说什么都可以。（小鸟脸红）...想做的事，也陪着你。",
	"SDS_doll9.name": "白井公仔",
	"SDS_doll9.description": "...，......。饿了。（盯）什么时候，可以吃掉你？......。不，不行。",
	"SDS_doll10.name": "白白公仔",
	"SDS_doll10.description": "白白大人出现！",
	"SDS_doll11.name": "晴空旅行箱",
	"SDS_doll11.description": "会让一段旅行的心情变得更好，它有点害羞，但是它很乐意帮你的忙！",
	"SDS_doll12.name": "晴空子母旅行箱",
	"SDS_doll12.description": "晴空旅行箱有了一个小帮手，现在，它有自信能帮到你了。",
	"SDS_doll13.name": "紫藤旅行箱",
	"SDS_doll13.description": "它来自一个种满紫藤花的小镇，现在，它时刻准备迈向新的旅行。",
	"SDS_doll14.name": "紫藤子母旅行箱",
	"SDS_doll14.description": "它喜欢自己的新搭档，那是它的第一个朋友！",
	"SDS_doll15.name": "桃红旅行箱",
	"SDS_doll15.description": "桃红旅行箱总是香香的，它喜欢香香的自己，也喜欢你。",
	"SDS_doll16.name": "桃红子母旅行箱",
	"SDS_doll16.description": "彼此搭配，干活不累！桃红很高兴自己能够有一个伙伴！",
	"SDS_doll17.name": "莱恩甜筒公仔",
	"SDS_doll17.description": "什么？你真的忍心吃掉人家？呜呜呜真是太伤心了...！（哭哭）",
	"SDS_doll18.name": "瑞恩甜筒公仔",
	"SDS_doll18.description": "呐、呐！你想吃掉我？大胆到让我想夸你了。笨蛋。",
	"SDS_doll19.name": "卢卡斯甜筒公仔",
	"SDS_doll19.description": "（试图伸手捂脸）（没有手）...我很高兴...！咳...那，我看看能不能变成你爱吃的口味。",
	"SDS_doll20.name": "洛离甜筒公仔",
	"SDS_doll20.description": "叽叽咕咕...我要融化了......！",
	"SDS_doll21.name": "莫尔甜筒公仔",
	"SDS_doll21.description": "你以为我会化掉？这只是个形象。",
	"SDS_doll22.name": "佩莱特甜筒公仔",
	"SDS_doll22.description": "这个形象很无用...你喜欢？...！那，还是有点用的。",
	"SDS_doll23.name": "霍夫塞普甜筒公仔",
	"SDS_doll23.description": "诶？你想吃掉我吗？嗯......虽然有点害怕，但是，我相信你...呜，可以轻一点吗？",
	"SDS_doll24.name": "乌列甜筒公仔",
	"SDS_doll24.description": "我是什么味道？不知道...你觉得像是香草？如果根据颜色判断...也可能是柠檬。",
	"SDS_doll25.name": "白井甜筒公仔",
	"SDS_doll25.description": "嗯......我能吃掉自己？......。能试试。为什么这么看着我？你要吃吗？给你。",
	"SDS_Ancientchair1.name": "八仙椅",
	"SDS_Ancientchair1.description": "由红木制成的椅子颇有韵味，最好搭配风格相称的家具，别浪费这么好的椅子，没错，说的就是你。",
	"SDS_Ancientchair2.name": "绣墩",
	"SDS_Ancientchair2.description": "东方传统凳具中最具特色的代表，有数层精美的雕花装饰，如果不能细看欣赏，就把它当做普通凳子吧。",
	"SDS_Ancientpainting1.name": "浅绛山水画",
	"SDS_Ancientpainting1.description": "以淡红青色彩渲染，以水墨勾画轮廓，在宣纸上赋予色彩不同的韵味。",
	"SDS_Ancientdecor1.name": "单屏屏风",
	"SDS_Ancientdecor1.description": "常用以隔断或是丰富室内空间，以红木制成，上面的纸并不怕水，但也别想着清洗它。",
	"SDS_Ancientdecor2.name": "红木屏风",
	"SDS_Ancientdecor2.description": "用繁复华丽的花纹遮掩主人的身影，不想见到谁，就让那个家伙待在屏风前面不许进来吧。",
	"SDS_Ancientdecor3.name": "绣墩",
	"SDS_Ancientdecor3.description": "东方传统凳具中最具特色的代表，有数层精美的雕花装饰，如果不能细看欣赏，就把它当做普通凳子吧。",
	"SDS_Ancientdecor4.name": "跪垫",
	"SDS_Ancientdecor4.description": "这个跪垫很柔软，但也别在上面待太久，求神拜佛，不如爱惜你自己的膝盖重要。",
	"SDS_Ancientdecor5.name": "红木香几",
	"SDS_Ancientdecor5.description": "适合与三两好友品茶谈天的矮桌。当然，不爱喝茶的话，就考虑一下把杯子里的饮品换换吧。",
	"SDS_Ancientdecor6.name": "回字纹卷口画缸",
	"SDS_Ancientdecor6.description": "画工精细，胎料足，青花发色亮丽，它有底气认为自己比放在里面的画更好看。",
	"SDS_Ancientdecor7.name": "红木联二橱",
	"SDS_Ancientdecor7.description": "用红木制成，既有储物仓储功能，顶层又可以置物，在橱柜门上方增加抽屉，便是一种旧时保险柜。",
	"SDS_Ancientdecor8.name": "红木斗柜",
	"SDS_Ancientdecor8.description": "在最下方添加了开放式置物空间...斗柜一般三四五层？这个怎么不算是三层呢。",
	"SDS_Ancientdecor9.name": "红木花架",
	"SDS_Ancientdecor9.description": "为了衬托而诞生的架子，但它不认为自己是配角，没有它，那些花能这么好看？这个家离了它得散！",
	"SDS_Ancientdecor10.name": "迎客松盆景",
	"SDS_Ancientdecor10.description": "它喜欢温暖的环境和水，当然，为了保持它的美观，你可要记得及时修剪——迎客松如是说。",
	"SDS_Ancientdecor11.name": "红木浮雕圆光罩",
	"SDS_Ancientdecor11.description": "用于内檐装饰与分割室内空间，常用于宫殿及贵族、富豪宅邸...没错！它身价很高的！工艺？不要在意！",
	"SDS_Ancientlamp1.name": "八角灯笼落地灯",
	"SDS_Ancientlamp1.description": "点亮时能够看见灯光透过罩面映射出花纹，古朴而令人安心。",
	"SDS_Ancientrug1.name": "古典回纹地毯",
	"SDS_Ancientrug1.description": "青绿色的地毯上用金色的线勾勒出回纹，简约大气，足以胜任需要宁静平和的环境。",
	"SDS_Ancienttable1.name": "红木书桌置文房四宝",
	"SDS_Ancienttable1.description": "笔墨纸砚端置在桌面上，只是坐着就会静下心来，或许会忍不住伸手写什么...例如鬼画符？",
	"SDS_Eggshellcouch1.name": "粉白茶杯椅",
	"SDS_Eggshellcouch1.description": "陷入这柔软的椅子吧！注意不要融化了，它是如此美好，真的有人不想坐一坐吗？",
	"SDS_Eggshellchair1.name": "草莓巧克力餐椅",
	"SDS_Eggshellchair1.description": "瞧它！多么甜蜜啊，千万不要将它错认成糖果屋里的家具，它可不适合用来吃。",
	"SDS_Eggshelltable1.name": "粉白梦境餐桌",
	"SDS_Eggshelltable1.description": "谁会不喜欢这么一张漂亮精致的餐桌呢？干净整洁，就像是梦中的餐桌。",
	"SDS_Eggshelltable2.name": "粉白梦境茶话会",
	"SDS_Eggshelltable2.description": "就像是梦里的茶话会，或许还可以更加梦幻甜蜜，要放点装饰吗？",
	"SDS_Eggshelldecor1.name": "薰衣草橱柜",
	"SDS_Eggshelldecor1.description": "适合在任何一个漂亮厨房里，似乎有股薰衣草的香气。",
	"SDS_Eggshelldecor2.name": "彩色调料罐",
	"SDS_Eggshelldecor2.description": "适合让分不清糖、盐还有味精的厨房杀手学会辨别他们...不会有人记不住自己放的哪个色吧？",
	"SDS_Eggshelldecor3.name": "茶杯兔兔抱枕",
	"SDS_Eggshelldecor3.description": "这只兔兔的身体？可可爱爱，没有身体，它看起来非常正常！",
	"SDS_Eggshelldecor4.name": "兴奋的茶杯兔兔",
	"SDS_Eggshelldecor4.description": "咖啡！红茶！茶话会！它等不及要参与其中了！",
	"SDS_Eggshelldecor5.name": "彩蛋专属收纳筐",
	"SDS_Eggshelldecor5.description": "把你在蛋蛋节获得的奖励统统放进来吧！什么？放不下？那就只放最漂亮的！",
	"SDS_Eggshelldecor6.name": "休息的茶杯兔兔",
	"SDS_Eggshelldecor6.description": "这只走错了茶话会出口的兔子似乎已经困了，或许是杯子里待着太安逸了呢。",
	"SDS_Eggshelldecor7.name": "白瓷盘",
	"SDS_Eggshelldecor7.description": "一个洁白无暇，放上任何东西都会像是艺术品的盘子...即使是最糟糕的厨艺，也会在上面变成行为艺术吧？",
	"SDS_Eggshelldecor8.name": "一叠白瓷盘",
	"SDS_Eggshelldecor8.description": "哦，我的天呐，这么漂亮的盘子居然有整整一叠？显然，它只是放着就很漂亮。",
	"SDS_Eggshelldecor9.name": "‘交错的天空’",
	"SDS_Eggshelldecor9.description": "像是黄昏与正午相逢，晕染的橘红与剔透的碧蓝汇聚...它就这样‘静静待在相框中。",
	"SDS_Eggshelldecor10.name": "欧式白瓷奶罐",
	"SDS_Eggshelldecor10.description": "常用来在下午茶时，为淑女绅士的杯中倒入一份新鲜牛奶，有谁想来一份下午茶吗？",
	"SDS_Eggshelldecor11.name": "白瓷茶杯",
	"SDS_Eggshelldecor11.description": "小巧的白瓷茶杯，很适合在午后的时间里用它喝一杯茶，当然，时间不是重点，午夜或者清晨来一杯也很好。",
	"SDS_Eggshelldecor12.name": "白瓷茶杯",
	"SDS_Eggshelldecor12.description": "小巧的白瓷茶杯，很适合在午后的时间里用它喝一杯茶，当然，时间不是重点，午夜或者清晨来一杯也很好。",
	"SDS_Eggshelldecor13.name": "透明糖果罐",
	"SDS_Eggshelldecor13.description": "玻璃制的糖果罐，只要在里面放上花花绿绿的糖果，就会变得无比诱人...它和糖果永不分离！",
	"SDS_Eggshelldecor14.name": "午后时光",
	"SDS_Eggshelldecor14.description": "茶话会少不了一份盛着精致点心的餐盘，现在，它会替你补上空缺，但是不要吃哦，有些东西的欣赏价值比其本身意味更高。",
	"SDS_Eggshelldecor15.name": "瓶制调料罐",
	"SDS_Eggshelldecor15.description": "精巧的小调料罐，玻璃瓶身可以看见里面的调料....别把糖和盐弄混！和味精弄混也不行！",
	"SDS_Eggshelldecor16.name": "来信",
	"SDS_Eggshelldecor16.description": "这是谁的来信？还带着写信人精心准备的心意。又或者，这并不是来信？",
	"SDS_Eggshelldecor17.name": "茶杯式盆栽",
	"SDS_Eggshelldecor17.description": "像是一个种在大号茶杯里的盆栽，仔细看看，是不是很像咖啡里长出了薄荷叶？",
	"SDS_Eggshelldecor18.name": "桃红兔兔彩蛋",
	"SDS_Eggshelldecor18.description": "看起来如此甜蜜的它不能吃！它很漂亮，而且做的很棒...它真的不能吃吗？",
	"SDS_Eggshelldecor19.name": "樱粉兔兔彩蛋",
	"SDS_Eggshelldecor19.description": "这么可爱的东西居然是家具，真的很让人惋惜，真的不能吃掉它吗？",
	"SDS_Eggshelldecor20.name": "薰衣草置物柜",
	"SDS_Eggshelldecor20.description": "可以和橱柜组合成漂亮的厨房，当然，它本身也很漂亮。",
	"SDS_Eggshelldecor21.name": "一叠白瓷盘",
	"SDS_Eggshelldecor21.description": "哦，我的天呐，这么漂亮的盘子居然有整整一叠？显然，它只是放着就很漂亮。",
	"SDS_Eggshelldecor22.name": "白瓷盘",
	"SDS_Eggshelldecor22.description": "一个洁白无暇，放上任何东西都会像是艺术品的盘子...即使是最糟糕的厨艺，也会在上面变成行为艺术吧？",
	"SDS_Eggshelldecor23.name": "樱桃",
	"SDS_Eggshelldecor23.description": "樱桃、樱桃...它到底是什么东西呢？这就要取决使用者的想法了...没错，这是哲学问题。",
	"SDS_Eggshellpainting1.name": "木制茶杯架",
	"SDS_Eggshellpainting1.description": "把你所有珍藏的咖啡杯都放上去吧！当然了，碰碎了它可不会负责。",
	"SDS_Eggshellpainting2.name": "‘装饰’盘子",
	"SDS_Eggshellpainting2.description": "就像花朵有假花，餐点有假的也正常，但它为什么做的如此诱人？这就是要的效果？那好吧。",
	"SDS_Eggshellpainting3.name": "‘绅士兔子的致意’",
	"SDS_Eggshellpainting3.description": "它直视着每一个敢于与它对视的勇者，它为这些勇者致意。",
	"SDS_Eggshellrug1.name": "甜蜜菱纹地毯",
	"SDS_Eggshellrug1.description": "浅粉、桃粉...哦...丝绒的触感，甜蜜柔软...",
	"SDS_Flowercouch1.name": "虞美人沙发",
	"SDS_Flowercouch1.description": "坐在里面，或许会变成花里诞生的妖精吧？",
	"SDS_Flowerchair1.name": "梅花软凳",
	"SDS_Flowerchair1.description": "坐在上面的时候，会闻到梅花的香气吧。",
	"SDS_Flowerchair2.name": "迎春花软凳",
	"SDS_Flowerchair2.description": "迎接春季的花，盛开在室内会让房间充满春意。",
	"SDS_Flowerchair3.name": "百合软凳",
	"SDS_Flowerchair3.description": "素白的百合安静的开着，淡雅，随时准备包容安置他人。",
	"SDS_Flowerdecor1.name": "春意书架",
	"SDS_Flowerdecor1.description": "一个小书架，简约却充满活力，在上面放一本常看的书吧。",
	"SDS_Flowerpainting1.name": "紫缎带遮阳帽",
	"SDS_Flowerpainting1.description": "有着紫色蝴蝶结的遮阳帽，很适合踏春的时候带出去。",
	"SDS_Flowerpainting2.name": "红缎带遮阳帽",
	"SDS_Flowerpainting2.description": "在春日的花田里，也许会有蝴蝶以为那一抹红色同样也是盛开的花吧？",
	"SDS_Flowerpainting3.name": "‘曼珠沙华’",
	"SDS_Flowerpainting3.description": "它在等待相遇，等待已经许久。",
	"SDS_Flowerdecor7.name": "春意香薰",
	"SDS_Flowerdecor7.description": "无需点燃，它只是静静在那里散发着香气，一如静谧的安宁春日。",
	"SDS_Flowerdecor8.name": "春季浇水壶",
	"SDS_Flowerdecor8.description": "最适合用来打理花园的浇水壶类型，有着漂亮的颜色，在花园里准备一个吧。",
	"SDS_Flowerdecor9.name": "郁金香落地灯",
	"SDS_Flowerdecor9.description": "像是一位纤纤美人，安静伫立着只为点亮身边。",
	"SDS_Flowerdecor10.name": "春意衣柜",
	"SDS_Flowerdecor10.description": "古朴简约而不失设计，它能够容纳你的衣服，所以尽情打扮自己，不要辜负春光灿烂。",
	"SDS_Flowerrug1.name": "太阳花地毯",
	"SDS_Flowerrug1.description": "只是看着这样灿烂又充满活力的地毯上，就会充满精神呢。",
	"SDS_Flowerdecor11.name": "太阳花圆桌",
	"SDS_Flowerdecor11.description": "虽然叫圆桌，但是因为花瓣，或许叫花瓣桌更合适？它今天也在思考自己的名称问题。",
	"SDS_Mushroomscouch1.name": "森林针织沙发",
	"SDS_Mushroomscouch1.description": "让自然的气息包裹你，融入其中，安稳的坐下，就像是安静生长的树木一般。",
	"SDS_Mushroomschair1.name": "红蘑菇圆凳",
	"SDS_Mushroomschair1.description": "像是梦游仙境中才会有的家具，别试着咬一口，它是家具...或者是很大的蘑菇？",
	"SDS_Mushroomschair2.name": "阳光菇圆凳",
	"SDS_Mushroomschair2.description": "看着就让人心情愉快，和它一起多晒晒太阳吧。",
	"SDS_Mushroomschair3.name": "幽灵菇圆凳",
	"SDS_Mushroomschair3.description": "不要被名字吓到，它是个柔软而温柔的凳子，会体贴一切。",
	"SDS_Mushroomschair4.name": "香菇圆凳",
	"SDS_Mushroomschair4.description": "看来它经历了很多，还被人切了花刀，可怜的香菇，但现在，它会有安身之所了。",
	"SDS_Mushroomspainting1.name": "红蘑菇置物架",
	"SDS_Mushroomspainting1.description": "墙上的置物架，容易让人出现自己是不是住在山洞里的幻觉，谁知道呢。",
	"SDS_Mushroomspainting2.name": "‘树叶的时间",
	"SDS_Mushroomspainting2.description": "用树叶制作成的相框，纯天然无污染，没有任何化工痕迹。",
	"SDS_Mushroomspainting3.name": "‘欢快的红蘑菇’",
	"SDS_Mushroomspainting3.description": "别被它们愉快的样子欺骗了，它们依旧是有毒的，但它们看起来很可怜，对吧？",
	"SDS_Mushroomspainting4.name": "‘蘑菇？蘑菇！’",
	"SDS_Mushroomspainting4.description": "蘑菇爱好者家里常常出现的画...蘑菇！",
	"SDS_Mushroomsdecor1.name": "香菇人银雕像",
	"SDS_Mushroomsdecor1.description": "是纯银的吗？它看起来很自豪于自己的模样。",
	"SDS_Mushroomsdecor2.name": "草莓香菇人",
	"SDS_Mushroomsdecor2.description": "它才不是草莓和香菇的混血，它只是穿了最爱的草莓色裙子！",
	"SDS_Mushroomsdecor3.name": "沉稳香菇人",
	"SDS_Mushroomsdecor3.description": "它很沉稳，它就像身上的裙子一样安静...香菇万岁~！",
	"SDS_Mushroomsdecor4.name": "香菇人金雕像",
	"SDS_Mushroomsdecor4.description": "人类们！臣服在金色传说的光辉下吧！",
	"SDS_Mushroomsdecor5.name": "红蘑菇标本",
	"SDS_Mushroomsdecor5.description": "红伞伞白杆杆...但是不许吃它！就算不是标本也不许吃！",
	"SDS_Mushroomsdecor6.name": "阳光菇标本",
	"SDS_Mushroomsdecor6.description": "它想晒晒太阳，或者动一动，你愿意满足它吗",
	"SDS_Mushroomsdecor7.name": "幽灵菇标本",
	"SDS_Mushroomsdecor7.description": "害羞的幽灵菇现在面临菇生最大考验——它要被展示了！",
	"SDS_Mushroomsdecor8.name": "香菇标本",
	"SDS_Mushroomsdecor8.description": "香菇在发呆Zzz......你要一起吗......",
	"SDS_Mushroomsdecor9.name": "森林储物柜",
	"SDS_Mushroomsdecor9.description": "静谧可靠，就像是森林，把你想要藏起的东西放进去吧，它是最好的保密者。",
	"SDS_Mushroomsdecor10.name": "森林书柜",
	"SDS_Mushroomsdecor10.description": "可以放置各种杂物，搜寻来的珍惜植物或者材料？没问题。",
	"SDS_Mushroomsdecor11.name": "树桩茶几",
	"SDS_Mushroomsdecor11.description": "时间给了它阅历，也给了它可靠的躯体，现在，它是你的了。",
	"SDS_Mushroomsrug1.name": "森林方形地毯",
	"SDS_Mushroomsrug1.description": "就像是修剪得宜的草坪一样精准而舒适，在上面站一会吗？",
	"SDS_Mushroomsrug3.name": "森林圆形地毯",
	"SDS_Mushroomsrug3.description": "它就像是一个花园，没法踏春的时候，就踏它吧。",
	"SDS_Mushroomstable1.name": "森林原木餐桌",
	"SDS_Mushroomstable1.description": "用打磨好的木材和柔软的隔热垫，一张完美的餐桌出现了！注意，它长出来的蘑菇不能吃。",
	"SDS_Pearlcouch1.name": "含珠贝壳沙发",
	"SDS_Pearlcouch1.description": "谁能拒绝一个粉色的贝壳椅和珍珠靠垫，甚至还有小泡泡！",
	"SDS_Pearlchair1.name": "粉海餐椅",
	"SDS_Pearlchair1.description": "舒适柔软，如此可爱，今天想吃点什么呢？",
	"SDS_Pearllamp1.name": "水母落地灯",
	"SDS_Pearllamp1.description": "粉水母用它的触须为你挡住了过分刺眼的光亮。说，谢谢水母。",
	"SDS_Pearldecor1.name": "粉海衣柜",
	"SDS_Pearldecor1.description": "也许是美人鱼的专属柜子？哦，原来是你用的？真有眼光！",
	"SDS_Pearldecor2.name": "粉海落地柜",
	"SDS_Pearldecor2.description": "可以储存大量宝物，这么好看实用的柜子，你真的不想要吗？",
	"SDS_Pearlpainting1.name": "海洋挂画",
	"SDS_Pearlpainting1.description": "珊瑚、海草，还有小丑鱼！看完它们，晚上会在海底梦游吗？",
	"SDS_Pearldecor3.name": "蓝星星",
	"SDS_Pearldecor3.description": "蓝星星很担心粉星星，也很担心自己。",
	"SDS_Pearldecor4.name": "珊瑚瓶",
	"SDS_Pearldecor4.description": "有着珊瑚装饰的淡蓝色瓶子，里面的珊瑚是活的...大概。",
	"SDS_Pearldecor5.name": "粉蓝双星",
	"SDS_Pearldecor5.description": "粉星星和蓝星星要一起探险了，今日目标，人类的家！",
	"SDS_Pearldecor6.name": "粉星星",
	"SDS_Pearldecor6.description": "这可不是某个海底知名男星！它是一只有志气的星星！",
	"SDS_Pearlrug1.name": "珍珠白地毯",
	"SDS_Pearlrug1.description": "简直像是用珍珠发出的光辉织成的地毯...它是不是真的在发光？好亮！",
	"SDS_Pearltable1.name": "海洋盛宴餐桌",
	"SDS_Pearltable1.description": "海洋在邀请你参加今天的盛宴，还有明天的、后天的，每一天！",
	"SDS_Pearltable2.name": "海洋盛宴餐桌",
	"SDS_Pearltable2.description": "海洋在邀请你参加今天的盛宴，还有明天的、后天的，每一天！",
	"SDS_Specialfurnituredecor1.name": "珊瑚葵葵海草花篮",
	"SDS_Specialfurnituredecor1.description": "霍夫塞普送的珊瑚葵葵海草花篮，呃....",
