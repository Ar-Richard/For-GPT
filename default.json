	"SDS.Dialogue.peipei.Resort_Bar": "嗷嗷。$2",
	"SDS.Dialogue.peipei.Resort_Chair": "嗷嗷。$1",
	"SDS.Dialogue.peipei.Resort_Dance": "嗷嗷。$0",
	"SDS.Dialogue.peipei.Resort_Entering": "嗷嗷。$1",
	"SDS.Dialogue.peipei.Resort_Leaving": "嗷嗷。$1",
	"SDS.Dialogue.peipei.Resort_Shore": "嗷嗷。$1",
	"SDS.Dialogue.peipei.Resort_Towel": "嗷嗷。$1",
